<Project Sdk="Microsoft.NET.Sdk;Microsoft.NET.Sdk.Publish">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CoenM.ImageSharp.ImageHash" Version="1.3.6" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.2.0" />
    <PackageReference Include="NetCord" Version="1.0.0-alpha.457" />
    <PackageReference Include="NetCord.Hosting" Version="1.0.0-alpha.457" />
    <PackageReference Include="NetCord.Hosting.AspNetCore" Version="1.0.0-alpha.457" />
    <PackageReference Include="NetCord.Hosting.Services" Version="1.0.0-alpha.457" />
    <PackageReference Include="NetCord.Services" Version="1.0.0-alpha.457" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Images\" />
  </ItemGroup>
  
  <ItemGroup>
    <Content Include="Images\**" CopyToPublishDirectory="PreserveNewest"/>
  </ItemGroup>
  
  <ItemGroup>
    <None Include="appsettings.json" CopyToPublishDirectory="Always" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Settings.job">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
